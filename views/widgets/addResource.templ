package widgets

templ AddResourceForm(email string) {
	<div id="add-resource-form-container" class="mt-2 bg-white rounded-lg shadow-sm border border-gray-100 p-3 hidden">
		<div id="add_resource-result"></div>
		<form
			hx-ext="response-targets"
			hx-post={ "/api/user/add_resource?email=" + email }
			hx-trigger="submit"
			hx-target="#add_resource-result"
			hx-swap="innerHTML swap:0.5s"
			hx-encoding="multipart/form-data"
			hx-on::after-request="if(event.detail.successful) this.reset()"
			class="flex flex-wrap items-end gap-3"
		>
			<!-- Статус -->
			<div class="flex flex-col min-w-[140px]">
				<label for="status" class="block text-xs font-medium text-gray-700 mb-1">Статус</label>
				<select
					id="status"
					name="status"
					required
					class="p-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
				>
					<option value="">—</option>
					<option value="Учтеное">Учтеное</option>
					<option value="Не учтеное">Не учтеное</option>
				</select>
			</div>
			<!-- Дата события -->
			<div class="flex flex-col min-w-[140px]">
				<label for="date" class="block text-xs font-medium text-gray-700 mb-1">Дата события</label>
				<input
					type="date"
					id="date"
					name="date"
					required
					class="p-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
				/>
			</div>
			<!-- Количество -->
			<div class="flex flex-col min-w-[100px]">
				<label for="quantity" class="block text-xs font-medium text-gray-700 mb-1">Кол-во</label>
				<input
					type="number"
					id="quantity"
					name="quantity"
					min="1"
					placeholder="1"
					class="p-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
				/>
			</div>
			<!-- Наименование ресурса -->
			<div class="flex flex-col flex-1 min-w-[200px]">
				<label for="name" class="block text-xs font-medium text-gray-700 mb-1">Наименование</label>
				<input
					type="text"
					id="name"
					name="name"
					placeholder="Ноутбук HP 250G5 SN: ..."
					required
					class="p-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
				/>
			</div>
			<!-- Описание -->
			<div class="flex flex-col flex-1 min-w-[180px]">
				<label for="description" class="block text-xs font-medium text-gray-700 mb-1">Описание</label>
				<input
					type="text"
					id="description"
					name="description"
					placeholder="КИ050881"
					class="p-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
				/>
			</div>
			<!-- Кнопка -->
			<div class="flex flex-col">
				<label class="block text-xs font-medium text-gray-700 mb-1 invisible">Действие</label>
				<button
					type="submit"
					class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors whitespace-nowrap"
				>
					Добавить
				</button>
			</div>
		</form>
	</div>
}
