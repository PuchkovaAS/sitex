package widgets

type AddResourceFormProps struct {
Email string
}

templ AddResourceForm(props AddResourceFormProps) {
<div id="add-resource-form-container" class="mt-2 bg-white rounded-lg shadow-sm border border-gray-100 p-3 hidden">
    <div id="add_resource-result"></div>
    <form class="flex flex-wrap items-end gap-3">
        <!-- Статус -->
        <div class="flex flex-col min-w-[140px]">
            <label for="status" class="block text-xs font-medium text-gray-700 mb-1">Статус</label>
            <select id="status" name="status" required
                class="p-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors">
                <option value="">—</option>
                <option value="Учтеное">Учтеное</option>
                <option value="Не учтеное">Не учтеное</option>
            </select>
        </div>
        <!-- Дата события -->
        <div class="flex flex-col min-w-[140px]">
            <label for="event_date" class="block text-xs font-medium text-gray-700 mb-1">Дата события</label>
            <input type="date" id="event_date" name="event_date" required
                class="p-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors" />
        </div>
        <!-- Наименование ресурса -->
        <div class="flex flex-col flex-1 min-w-[200px]">
            <label for="resource_name" class="block text-xs font-medium text-gray-700 mb-1">Наименование</label>
            <input type="text" id="resource_name" name="resource_name" placeholder="Ноутбук HP 250G5 SN: ..." required
                class="p-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors" />
        </div>
        <!-- Описание -->
        <div class="flex flex-col flex-1 min-w-[180px]">
            <label for="description" class="block text-xs font-medium text-gray-700 mb-1">Описание</label>
            <input type="text" id="description" name="description" placeholder="КИ050881"
                class="p-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors" />
        </div>
        <!-- Кнопка -->
        <div class="flex flex-col">
            <label class="block text-xs font-medium text-gray-700 mb-1 invisible">Действие</label>
            <button type="submit"
                class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors whitespace-nowrap">
                Добавить
            </button>
        </div>
    </form>
</div>
}
