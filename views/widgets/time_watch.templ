package widgets

templ TimeWatch() {
	<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-600">
		<span class="flex items-center gap-1.5">
			Опоздания:
			<span class="font-medium text-orange-600">15 мин (2)</span>
		</span>
		<span class="flex items-center gap-1.5">
			Ранние уходы:
			<span class="font-medium text-rose-600">26 мин (3)</span>
		</span>
	</div>
}
