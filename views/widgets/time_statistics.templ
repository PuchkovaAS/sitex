package widgets

import "sitex/views/components"
import "time"
import "sitex/views/view_utils"

type TimeStatisticsProps struct {
	MonthName  string
	Stats      map[string]int
	Email      string
	StatusText string
	FirstName  string
	LastName   string
	Position   string
	Department string
	IsAdmin    bool
	IsActive   bool
}

templ TimeStatistics(props TimeStatisticsProps) {
	{{
year := time.Now().Year()
statuses := []string{
	// ───────────── РАБОТА ─────────────
	"В офисе",
	"Командировка",
	"Удаленная работа",
	"Работа в выходной день",

	// ───────────── ОТПУСК / ОТДЫХ ─────────────
	"Отпуск",
	"Отпуск за свой счёт",
	"Выходной",

	// ───────────── ОТСУТСТВИЕ ─────────────
	"Больничный",

	// ───────────── ДОПОЛНИТЕЛЬНО ─────────────
	"Отгул",
}
	}}
	<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-6">
		<!-- Заголовок -->
		<div class="flex items-center justify-between mb-6">
			<h2 class="text-lg font-semibold text-gray-900">
				Статистика активности за <span class="text-blue-600">{ props.MonthName } { year }</span>
			</h2>
		</div>
		<div class="flex items-center gap-6 bg-white">
			<!-- Аватар и основная информация -->
			<div class="flex items-center flex-shrink-0">
				@components.EmployeerAvatar(props.FirstName, props.LastName, props.IsActive)
				@components.EmployeeInfo(components.EmployeeInfoProps{
					Email:      props.Email,
					StatusText: props.StatusText,
					FirstName:  props.FirstName,
					LastName:   props.LastName,
					Position:   props.Position,
					IsAdmin:    props.IsAdmin,
					Department: props.Department,
				})
			</div>
			<!-- Статистика по статусам -->
			<div class="flex-1">
				<div class="grid grid-cols-9 gap-4">
					for _, status := range statuses {
						@StatusCard(status, props.Stats[status])
					}
				</div>
			</div>
		</div>
		<!-- 🔹 Блок учёта времени — гармонично внизу карточки -->
		@TimeWatch()
	</div>
}

templ StatusCard(status string, count int) {
	{{
statusClass := viewutils.GetStatusClass(status)
displayName := viewutils.GetDisplayName(status)
	}}
	<div
		class={ "flex flex-col items-center justify-center rounded-lg p-4 min-h-[90px] hover:shadow-md transition-shadow" ,
    statusClass }
	>
		<span class={ "text-xl font-bold" , viewutils.GetTextColorClass(status) }>{ count }</span>
		<span class={ "text-xs font-medium text-center mt-1" , viewutils.GetTextColorClass(status) }>{ displayName }</span>
	</div>
}
