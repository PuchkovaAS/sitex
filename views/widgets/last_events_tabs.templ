package widgets

import "sitex/internal/user"

type EventsProps struct {
	LastAddStatus []user.StatusPeriod
}

templ LastEventsTabs(props EventsProps, isAdmin bool) {
	<div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 max-w-2xl mx-auto">
		<!-- Переключатели -->
		<div class="flex space-x-2 mb-4 border-b border-gray-200">
			<button
				type="button"
				onclick="showLastEventsTab('status')"
				id="last-tab-status"
				class="pb-2 px-3 text-sm font-medium text-blue-600 border-b-2 border-blue-600 whitespace-nowrap"
			>
				Последние статусы
			</button>
			if isAdmin {
				<button
					type="button"
					onclick="showLastEventsTab('time')"
					id="last-tab-time"
					class="pb-2 px-3 text-sm font-medium text-gray-500 hover:text-gray-700 border-b-2 border-transparent whitespace-nowrap transition-colors"
				>
					Последние временные события
				</button>
			}
		</div>
		<!-- Секции событий -->
		<div id="last-events-status" class="block">
			<div class="flex flex-col mt-2">
				for _, item := range props.LastAddStatus {
					<div class="mb-2">
						@StatusEventWidget(StatusEventProps{
							ID:           int(item.ID),
							Status:       item.StatusType.Name,
							Date:         item.StartDate,
							Description:  item.Comment,
							UserName:     item.Employee.LastName + " " + item.Employee.FirstName,
							OneTimeEvent: item.OneTimeEvent,
							DateAdd:      item.UpdatedAt,
							WhoAddEvent:  item.WhoAdded.LastName + " " + item.WhoAdded.FirstName,
							Email:        item.Employee.Email,
						})
					</div>
				}
			</div>
		</div>
		if isAdmin {
			<div id="last-events-time" class="hidden">
				<div class="flex flex-col mt-2">
					for _, item := range props.LastAddStatus {
						<div class="mb-2">
							@StatusEventWidget(StatusEventProps{
								ID:           int(item.ID),
								Status:       item.StatusType.Name,
								Date:         item.StartDate,
								Description:  item.Comment,
								UserName:     item.Employee.LastName + " " + item.Employee.FirstName,
								OneTimeEvent: item.OneTimeEvent,
								DateAdd:      item.UpdatedAt,
								WhoAddEvent:  item.WhoAdded.LastName + " " + item.WhoAdded.FirstName,
								Email:        item.Employee.Email,
							})
						</div>
					}
				</div>
			</div>
		}
	</div>
	<script>
    function showLastEventsTab(tab) {
        const statusSection = document.getElementById('last-events-status');
        const timeSection = document.getElementById('last-events-time');
        const tabStatus = document.getElementById('last-tab-status');
        const tabTime = document.getElementById('last-tab-time');

        // Скрыть все секции
        if (statusSection) statusSection.classList.add('hidden');
        if (timeSection) timeSection.classList.add('hidden');

        // Сбросить активный стиль
        if (tabStatus) {
            tabStatus.classList.replace('text-blue-600', 'text-gray-500');
            tabStatus.classList.replace('border-blue-600', 'border-transparent');
        }
        if (tabTime) {
            tabTime.classList.replace('text-blue-600', 'text-gray-500');
            tabTime.classList.replace('border-blue-600', 'border-transparent');
        }

        // Показать выбранную вкладку
        if (tab === 'status' && tabStatus && statusSection) {
            statusSection.classList.remove('hidden');
            tabStatus.classList.replace('text-gray-500', 'text-blue-600');
            tabStatus.classList.replace('border-transparent', 'border-blue-600');
        } else if (tab === 'time' && tabTime && timeSection) {
            timeSection.classList.remove('hidden');
            tabTime.classList.replace('text-gray-500', 'text-blue-600');
            tabTime.classList.replace('border-transparent', 'border-blue-600');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        showLastEventsTab('status');
    });
</script>
}
