package views

import (
	"sitex/views/components"
	"sitex/views/layout"
)

type DocsListPageProps struct {
	Files       []string
	CurrentFile string
	IsAdmin     bool
}

templ DocsListPage(props DocsListPageProps) {
	@layout.Layout(layout.LayoutProps{
		Title:           "Документация",
		MetaDescription: "Список доступных документов",
		IsAuthenticated: true,
	}) {
		<div class="w-full p-6">
			<!-- Заголовок -->
			<div class="mb-8">
				<h1 class="text-2xl font-semibold text-gray-900">Документация</h1>
				<p class="text-gray-600 mt-2">Доступные документы и руководства</p>
			</div>
			<!-- Список файлов -->
			@components.DocsList(components.DocsListProps{
				Files:       props.Files,
				CurrentFile: props.CurrentFile,
			})
		</div>
	}
}
