package views

import "sitex/views/layout"

type DocsTreePageProps struct {
	TreeHTML string
	Folder   string
}

templ DocsTreePage(props DocsTreePageProps) {
	@layout.Layout(layout.LayoutProps{
		Title:           "Документация",
		MetaDescription: "Список доступных документов",
		IsAuthenticated: true,
	}) {
		<div class="w-full p-6">
			<h1 class="text-2xl font-semibold text-gray-900">Документация</h1>
			<p class="text-gray-600 mt-2">Доступные документы и руководства</p>
			<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mt-6">
				<h2 class="text-lg font-semibold text-gray-900 mb-4">Документы</h2>
				@templ.Raw(props.TreeHTML)
			</div>
		</div>
	}
}
