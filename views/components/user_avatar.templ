package components

import "sitex/internal/dt"
import "sitex/views/view_utils"

templ UserAvatar() {
	{{userInfo := ctx.Value("user_info").(dt.UserInfo)
initials := viewutils.GetInitals(userInfo.FirstName, userInfo.LastName)
	}}
	<div
		class={
			"w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 relative",
			templ.KV("bg-gradient-to-r from-blue-500 to-indigo-600", userInfo.IsActive), templ.KV("bg-gray-300",
				!userInfo.IsActive),
		}
	>
		<span
			class={
				"text-white font-semibold", templ.KV("text-xs", len(initials) <= 3), templ.KV("text-sm",
					len(initials) > 3 && len(initials) <= 4), templ.KV("text-sm", len(initials) > 4),
			}
		>
			{ initials }
		</span>
		if !userInfo.IsActive {
			<div class="absolute -top-1 -right-1">
				<div class="relative group">
					<div class="w-4 h-4 bg-red-500 rounded-full flex items-center justify-center">
						<svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
							<path
								fill-rule="evenodd"
								d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
								clip-rule="evenodd"
							></path>
						</svg>
					</div>
					<div
						class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-2 py-1 bg-gray-800 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap"
					>
						Неактивный аккаунт
						<div
							class="absolute top-full left-1/2 transform -translate-x-1/2 border-4 border-transparent border-t-gray-800"
						></div>
					</div>
				</div>
			</div>
		}
	</div>
}
