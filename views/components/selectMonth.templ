package components

type SelcectMonthProps struct {
CurrentMonth int
}

templ SelectMonth(props SelcectMonthProps) {
<div class="w-full md:w-auto">
    <label for="month" class="block text-sm font-medium text-gray-700 mb-1">Месяц</label>
    <select id="month" name="month" onchange="changeMonth(this.value)"
        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
        <option value="1" selected={ props.CurrentMonth==1 }>Январь</option>
        <option value="2" selected={ props.CurrentMonth==2 }>Февраль</option>
        <option value="3" selected={ props.CurrentMonth==3 }>Март</option>
        <option value="4" selected={ props.CurrentMonth==4 }>Апрель</option>
        <option value="5" selected={ props.CurrentMonth==5 }>Май</option>
        <option value="6" selected={ props.CurrentMonth==6 }>Июнь</option>
        <option value="7" selected={ props.CurrentMonth==7 }>Июль</option>
        <option value="8" selected={ props.CurrentMonth==8 }>Август</option>
        <option value="9" selected={ props.CurrentMonth==9 }>Сентябрь</option>
        <option value="10" selected={ props.CurrentMonth==10 }>Октябрь</option>
        <option value="11" selected={ props.CurrentMonth==11 }>Ноябрь</option>
        <option value="12" selected={ props.CurrentMonth==12 }>Декабрь</option>
    </select>
</div>
}
