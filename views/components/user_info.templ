package components

import (
"fmt"
"sitex/internal/dt"
"sitex/views/view_utils"
)

templ UserInfo(isMenuVisible bool) {
{{ email := ctx.Value("email") }}
{{ status := ctx.Value("user_status") }}
{{ userInfo := ctx.Value("user_info").(dt.UserInfo) }}
{{
statusText := status.(string)
statusClass := viewutils.GetStatusClass(statusText)
emailParam := fmt.Sprintf("?email=%s", email)
}}
<div class="ml-3 flex flex-col items-start relative group">
    <!-- Основная информация (кликабельная область) -->
    <a href={ fmt.Sprintf("/profile%s", emailParam) }
        class="flex flex-col items-start hover:bg-gray-50 p-2 rounded-lg transition-colors">
        <!-- ФИО с короной админа -->
        <div class="flex items-center gap-2 mb-1">
            <p class="text-sm font-medium text-gray-900">
                { userInfo.LastName } { userInfo.FirstName }
            </p>
            if userInfo.IsAdmin {
            <div class="relative">
                <svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                    <path
                        d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z">
                    </path>
                </svg>
            </div>
            }
        </div>
        <!-- Должность -->
        <span class="text-xs text-gray-600 mb-2">
            { userInfo.Position }
        </span>
        <!-- Статус -->
        <span class={ "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium " + statusClass }>
            { statusText }
        </span>
    </a>
    if isMenuVisible {
    <!-- Выпадающее меню при наведении -->
    @UserLinks(emailParam)
    }
</div>
}
