package components

type NotificationStatus string

const (
    NotificationSuccess NotificationStatus = "success"
    NotificationFail    NotificationStatus = "fail"
)

templ Notification(message string, status NotificationStatus) {
    <div class={
        "max-w-sm w-full p-4 rounded-lg shadow-lg border transform transition-all duration-300",
        templ.KV("bg-green-100 border-green-300 text-green-800", status == NotificationSuccess),
        templ.KV("bg-red-100 border-red-300 text-red-800", status == NotificationFail),
    }>
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <!-- Иконка -->
                <div class={
                    "mr-3",
                    templ.KV("text-green-500", status == NotificationSuccess),
                    templ.KV("text-red-500", status == NotificationFail),
                }>
                    if status == NotificationSuccess {
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                    } else {
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    }
                </div>
                <!-- Текст -->
                <p class="text-sm font-medium">
                    { message }
                </p>
            </div>
            <!-- Кнопка закрытия -->
            <button 
                type="button" 
                class="ml-4 text-gray-400 hover:text-gray-600 transition-colors"
                onclick="this.parentElement.parentElement.remove()"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>
    <!-- Скрипт для автоматического закрытия -->
    <script>
        setTimeout(() => {
            const notification = document.currentScript.previousElementSibling;
            if (notification) {
                notification.remove();
            }
        }, 5000);
    </script>
}