package components

type DocsListProps struct {
	Files       []string
	CurrentFile string
}

templ DocsList(props DocsListProps) {
	<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
		<h2 class="text-lg font-semibold text-gray-900 mb-4">Документы</h2>
		if len(props.Files) == 0 {
			<p class="text-gray-500">Нет доступных документов</p>
		} else {
			<div class="space-y-2">
				for _, file := range props.Files {
					{{
	isActive := file == props.CurrentFile
	fileName := file
	if len(fileName) > 50 {
		fileName = fileName[:47] + "..."
	}
	classes := "block px-4 py-3 rounded-lg transition-colors"
	if isActive {
		classes += " bg-blue-50 text-blue-700 font-medium"
	} else {
		classes += " text-gray-700 hover:bg-gray-50"
	}
					}}
					<a href={ "/docs/view/" + file } class={ classes }>
						<div class="flex items-center">
							<svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
								></path>
							</svg>
							<span>{ fileName }</span>
						</div>
					</a>
				}
			</div>
		}
	</div>
}
