package views

import (
	"fmt"
	"sitex/internal/user"
	"sitex/views/layout"
	"sitex/views/view_utils"
)

type ProfileProps struct {
	Employee user.Employee
}

templ ProfilePage(props ProfileProps) {
	@layout.Layout(layout.LayoutProps{
		Title:           "Профиль пользователя",
		MetaDescription: "Личный кабинет пользователя",
		IsAuthenticated: true,
	}) {
		{{
initials := viewutils.GetInitals(props.Employee.FirstName, props.Employee.LastName)
		}}
		<div class="w-full p-6">
			<!-- Заголовок -->
			<div class="mb-8">
				<h1 class="text-lg font-semibold text-gray-900">Профиль пользователя</h1>
				<p class="text-gray-600 mt-2">Основная информация и настройки аккаунта</p>
			</div>
			<!-- Основная карточка профиля -->
			<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
				<!-- Аватар и основная информация -->
				<div class="flex items-center mb-8">
					<div
						class="w-20 h-20 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center text-white text-3xl font-bold"
					>
						{ initials }
					</div>
					<div class="ml-6">
						<h2 class="text-lg font-semibold text-gray-900">
							{ props.Employee.FirstName } { props.Employee.LastName }
						</h2>
						<p class="text-gray-500 text-lg">{ props.Employee.Email }</p>
					</div>
				</div>
				<!-- Информационные карточки -->
				<div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
					<!-- Должность -->
					<div class="bg-gray-50 rounded-lg p-4">
						<div class="flex items-center mb-2">
							<span class="text-sm font-medium text-gray-700">Должность</span>
						</div>
						<p class="text-gray-900 font-semibold text-lg">
							{ props.Employee.Position }
						</p>
					</div>
					<!-- Отдел -->
					<div class="bg-gray-50 rounded-lg p-4">
						<div class="flex items-center mb-2">
							<span class="text-sm font-medium text-gray-700">Отдел</span>
						</div>
						<p class="text-gray-900 font-semibold text-lg">
							{ props.Employee.Department }
						</p>
					</div>
					<!-- Статус -->
					<div class="bg-gray-50 rounded-lg p-4">
						<div class="flex items-center mb-2">
							<span class="text-sm font-medium text-gray-700">Статус</span>
						</div>
						if props.Employee.IsActive {
							<p class="font-semibold text-lg text-green-600">
								Активен
							</p>
						} else {
							<p class="font-semibold text-lg text-gray-600">
								Неактивен
							</p>
						}
					</div>
				</div>
				<!-- Права администратора -->
				if props.Employee.IsAdmin {
					<div class="bg-blue-50 rounded-lg p-4 border border-blue-200 mb-6">
						<div class="flex items-center mb-2">
							<svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
								></path>
							</svg>
							<span class="text-sm font-medium text-blue-700">Права доступа</span>
						</div>
						<p class="text-blue-800 text-lg">
							Администратор: полный доступ к системе
						</p>
					</div>
				} else {
					<div class="bg-green-50 rounded-lg p-4 border border-green-200 mb-6">
						<div class="flex items-center mb-2">
							<svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
								></path>
							</svg>
							<span class="text-sm font-medium text-green-700">Права доступа</span>
						</div>
						<p class="text-green-800 text-lg">
							Сотрудник: стандартный доступ
						</p>
					</div>
				}
				<!-- Кнопки действий -->
				<div class="border-t border-gray-200 pt-6 flex space-x-4">
					<a
						href={ fmt.Sprintf("/profile_update?email=%s", props.Employee.Email) }
						class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium flex items-center text-base"
					>
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
							></path>
						</svg>
						Редактировать профиль
					</a>
					<a
						href={ fmt.Sprintf("/change_password?email=%s", props.Employee.Email) }
						class="px-6 py-3 bg-green-700 text-white rounded-lg hover:bg-green-800 transition-colors font-medium flex items-center text-base"
					>
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
							></path>
						</svg>
						Сменить пароль
					</a>
				</div>
			</div>
		</div>
	}
}
