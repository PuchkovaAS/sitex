package views

import (
"fmt"
"sitex/internal/resources"
"sitex/internal/user"
"sitex/views/components"
"sitex/views/layout"
"sitex/views/widgets"
)

type UsersResourcesProps struct {
Resources []resources.Resource
TotalItems int
TotalPage int
CurrentPage int
Depatrments []user.Department
DepartmentId int
QueryParams map[string]string
Status string
}

templ UsersReources(props UsersResourcesProps) {
@layout.Layout(layout.LayoutProps{
Title: "Материальные ресурсы",
MetaDescription: "Страница материальных ресурсов",
IsAuthenticated: true,
}) {
<div class="space-y-3">
    <!-- Фильтры и поиск -->
    <div class="bg-white rounded-lg shadow p-4">
        <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
            <!-- Левая часть: отдел и месяц -->
            <div class="flex flex-col md:flex-row gap-4 w-full md:w-auto">
                <!-- Выбор отдела -->
                <div class="w-full md:w-auto">
                    <label for="department" class="block text-sm font-medium text-gray-700 mb-1">Отдел</label>
                    <select id="department" name="department" onchange="changeDepartment(this.value)"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                        <option value="0" selected={ props.DepartmentId==0 }>Все отделы</option>
                        for _, department := range props.Depatrments {
                        if department.ID == uint(props.DepartmentId) {
                        <option value={ fmt.Sprintf("%d", department.ID) } selected>
                            { fmt.Sprintf("%s", department.Name) }
                        </option>
                        } else {
                        <option value={ fmt.Sprintf("%d", department.ID) }>
                            { fmt.Sprintf("%s", department.Name) }
                        </option>
                        }
                        }
                    </select>
                </div>
                <div class="w-full md:w-auto">
                    <label for="status" class="block text-sm font-medium text-gray-700 mb-1">
                        Статус
                    </label>
                    <select id="status" name="status" onchange="changeStatus(this.value)"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500">
                        if props.Status == "" {
                        <option value="" selected>Все статусы</option>
                        } else {
                        <option value="">Все статусы</option>
                        }
                        if props.Status == "Учтеное" {
                        <option value="Учтеное" selected>
                            Учтеное
                        </option>
                        } else {
                        <option value="Учтеное">
                            Учтеное
                        </option>
                        }
                        if props.Status == "Не учтеное" {
                        <option value="Не учтеное" selected>
                            Не учтеное
                        </option>
                        } else {
                        <option value="Не учтеное">
                            Не учтеное
                        </option>
                        }
                    </select>
                </div>
            </div>
            <!-- Правая часть: поиск -->
            <div class="w-full md:w-auto">
                @components.FindBy("Поиск", "Введите ФИО, наименование или описание")
            </div>
        </div>
    </div>
    <div class="my-2 p-2 ">
        <h3 class="mb-4 text-lg font-semibold text-gray-900">Материальные ресурсы</h3>
        @components.CounterItemsPage(components.CounterItemsProps{
        CurrentPage: props.CurrentPage,
        TotalItems: props.TotalItems,
        TotalPages: props.TotalPage,
        })
    </div>
    <div class="flex flex-col  mt-2">
        for _, item := range props.Resources {
        <div class="mb-2">
            @widgets.ResourceStatusWidget(widgets.ResourceStatusProps{
            ID: int(item.ID),
            Status: item.Status,
            ResourceName: item.ResourceName,
            Description: item.Description,
            UserName: item.Employee.LastName + " " + item.Employee.FirstName,
            Email: item.Employee.Email,
            Quantity: item.Quantity,
            WhoAddEvent: item.AddedBy.LastName + " " + item.AddedBy.FirstName,
            DateAdd: item.Date,
            IsAdmin: true,
            CreatedAt: item.CreatedAt,
            })
        </div>
        }
    </div>
    @components.PaginationNum(components.PaginationNumProps{
    UrlPath: "/users_resources?",
    TotalPage: props.TotalPage,
    CurrentPage: props.CurrentPage,
    QueryParams: props.QueryParams,
    })
</div>
@UsersResourcesScript()
}
}

templ UsersResourcesScript() {
<script>
    function changeDepartment(deptId) {
        const searchInput = document.getElementById('search');
        const statusSelect = document.getElementById('status');
        const searchQuery = searchInput ? searchInput.value.trim() : '';
        const statusValue = statusSelect ? statusSelect.value : '';

        const url = new URL(window.location.href);
        url.searchParams.set('department', deptId);
        url.searchParams.set('page', '1');

        if (searchQuery) {
            url.searchParams.set('search', searchQuery);
        } else {
            url.searchParams.delete('search');
        }

        if (statusValue) {
            url.searchParams.set('status', statusValue);
        } else {
            url.searchParams.delete('status');
        }

        window.location.href = url.toString();
    }

    function changeStatus(statusValue) {
        const searchInput = document.getElementById('search');
        const deptSelect = document.getElementById('department');
        const searchQuery = searchInput ? searchInput.value.trim() : '';
        const deptId = deptSelect ? deptSelect.value : '0';

        const url = new URL(window.location.href);
        url.searchParams.set('status', statusValue);
        url.searchParams.set('page', '1');

        if (searchQuery) {
            url.searchParams.set('search', searchQuery);
        } else {
            url.searchParams.delete('search');
        }

        url.searchParams.set('department', deptId); // сохраняем отдел

        window.location.href = url.toString();
    }

    function performSearch() {
        const searchInput = document.getElementById('search');
        const deptSelect = document.getElementById('department');
        const statusSelect = document.getElementById('status');

        if (!searchInput || !deptSelect || !statusSelect) return;

        const searchQuery = searchInput.value.trim();
        const deptId = deptSelect.value;
        const statusValue = statusSelect.value;

        const url = new URL(window.location.href);
        url.searchParams.set('page', '1');
        url.searchParams.set('department', deptId);

        if (searchQuery) {
            url.searchParams.set('search', searchQuery);
        } else {
            url.searchParams.delete('search');
        }

        if (statusValue) {
            url.searchParams.set('status', statusValue);
        } else {
            url.searchParams.delete('status');
        }

        window.location.href = url.toString();
    }

    // Обработка нажатия Enter в поле поиска
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('search');
        if (searchInput) {
            searchInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    performSearch();
                }
            });
        }
    });

    // Функция для формирования URL с текущими параметрами (для пагинации)
    function buildPageURL(page) {
        const url = new URL(window.location.href);
        url.searchParams.set('page', page.toString());

        // Очищаем пустые параметры
        ['search', 'status'].forEach(param => {
            const value = url.searchParams.get(param);
            if (!value || value.trim() === '') {
                url.searchParams.delete(param);
            }
        });

        return url.toString();
    }
</script>
}
