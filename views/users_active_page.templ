package views

import (
	"fmt"
	"sitex/internal/user"
	"sitex/views/components"
	"sitex/views/layout"
	"sitex/views/view_utils"
	"sitex/views/widgets"
)

type MultiUserActivityPageProps struct {
	Users             []user.ActivityInfo
	Department        []user.Department
	CurrentDepartment string
	CurrentPage       int
	TotalPages        int
	TotalUsers        int
}

templ MultiUserActivityPage(props MultiUserActivityPageProps) {
	@layout.Layout(layout.LayoutProps{
		Title:           "Активность сотрудников",
		MetaDescription: "Страница активности сотрудников",
		IsAuthenticated: true,
	}) {
		<div class="space-y-4">
			<!-- Фильтры и поиск -->
			<div class="bg-white rounded-lg shadow p-4">
				<div class="flex flex-col md:flex-row gap-4 items-center justify-between">
					<!-- Левая часть: отдел и месяц -->
					<div class="flex flex-col md:flex-row gap-4 w-full md:w-auto">
						<!-- Выбор отдела -->
						<div class="w-full md:w-auto">
							<label for="department" class="block text-sm font-medium text-gray-700 mb-1">Отдел</label>
							<select
								id="department"
								name="department"
								onchange="changeDepartment(this.value)"
								class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"
							>
								<option value="0" selected={ props.CurrentDepartment == "0" }>Все отделы</option>
								for _, department := range props.Department {
									<option
										value={ fmt.Sprintf("%d", department.Id) }
										selected={ fmt.Sprintf("%d",
                            department.Id)==props.CurrentDepartment }
									>
										{ fmt.Sprintf("%s", department.Name) }
									</option>
								}
							</select>
						</div>
						<!-- Выбор месяца -->
						@components.SelectMonth(components.SelcectMonthProps{CurrentMonth: 9})
					</div>
					<!-- Правая часть: поиск -->
					<div class="w-full md:w-auto">
						@components.FindUser()
					</div>
				</div>
			</div>
			<!-- Список пользователей -->
			<div>
				<div class="divide-y divide-gray-200">
					for curInd, currentUser := range props.Users {
						<!-- Тестовые пользователи -->
						<div class="p-4">
							<!-- Статистика пользователя -->
							@widgets.TimeStatistics(viewutils.GetMonthName(currentUser.CurrentMonth), currentUser.StatusCount)
							<!-- Кнопка раскрытия -->
							<div class="flex justify-center mt-2">
								<button class="p-1 bg-white rounded-lg shadow hover:bg-gray-50 transition-colors">
									<svg
										id={ fmt.Sprintf("toggle-icon-user-%d", curInd) }
										class="w-3 h-3 text-gray-500 transform rotate-0 transition-transform"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
									</svg>
								</button>
							</div>
							<!-- Блок активности пользователя (изначально скрыт) -->
							<div id={ fmt.Sprintf("user-%d", curInd) } class="hidden bg-white rounded-lg shadow p-4 mt-2">
								<div class="flex items-center justify-between mb-3">
									<!-- Левая часть: Управление активностью -->
									<div class="flex items-center gap-6">
										<h2 class="text-lg font-semibold text-gray-900">
											Управление активностью
										</h2>
									</div>
								</div>
								<div>
									<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
										<!-- Два календаря (занимают 3 колонки) -->
										<div class="lg:col-span-3">
											<div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-4xl mx-auto">
												<!-- Календари -->
												if len(currentUser.MonthHistory) > 0 {
													<div class="flex items-center justify-center">
														@widgets.Calendar(widgets.CalendarProps{
															MonthName:     currentUser.MonthHistory[0].Name,
															FirstDay:      currentUser.MonthHistory[0].WeekdayFirstMonth,
															HistoryStatus: currentUser.MonthHistory[0].HistoryStatus,
														})
													</div>
												}
												if len(currentUser.MonthHistory) > 1 {
													<div class="flex items-center justify-center">
														@widgets.Calendar(widgets.CalendarProps{
															MonthName:     currentUser.MonthHistory[1].Name,
															FirstDay:      currentUser.MonthHistory[1].WeekdayFirstMonth,
															HistoryStatus: currentUser.MonthHistory[1].HistoryStatus,
														})
													</div>
												}
											</div>
										</div>
										<!-- Форма добавления статуса -->
										<div>
											@widgets.AddStatus()
										</div>
									</div>
								</div>
							</div>
						</div>
					}
				</div>
				<!-- Пагинация -->
				@components.PaginationNum()
			</div>
		</div>
	}
	@MultiUserActivityPageScripts()
}

templ MultiUserActivityPageScripts() {
	<script>
    function toggleUserCalendar(userId) {
        const element = document.getElementById(userId);
        const icon = document.getElementById('toggle-icon-' + userId);

        if (element.classList.contains('hidden')) {
            element.classList.remove('hidden');
            icon.classList.remove('rotate-0');
            icon.classList.add('rotate-180');
        } else {
            element.classList.add('hidden');
            icon.classList.remove('rotate-180');
            icon.classList.add('rotate-0');
        }
    }

    function changeDepartment(deptId) {
        const searchInput = document.getElementById('search');
        const searchQuery = searchInput ? searchInput.value : '';
        const url = new URL(window.location.href);
        url.searchParams.set('department', deptId);
        url.searchParams.set('page', '1');
        if (searchQuery) {
            url.searchParams.set('search', searchQuery);
        }
        window.location.href = url.toString();
    }

    function performSearch() {
        const searchInput = document.getElementById('search');
        const deptSelect = document.getElementById('department');

        if (!searchInput || !deptSelect) return;

        const searchQuery = searchInput.value;
        const deptId = deptSelect.value;
        const url = new URL(window.location.href);
        url.searchParams.set('search', searchQuery);
        url.searchParams.set('department', deptId);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    }

    // Обработка нажатия Enter в поле поиска
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('search');
        if (searchInput) {
            searchInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    performSearch();
                }
            });
        }
    });
</script>
}
