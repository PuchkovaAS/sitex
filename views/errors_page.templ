package views

import "sitex/views/layout"

templ Errors404Page() {
@layout.Layout(layout.LayoutProps{
Title: "Ошибка 404 - Страница не найдена",
MetaDescription: "Страница, которую вы ищете, не существует",
IsAuthenticated: false,
})
<div class="min-h-screen flex items-center justify-center bg-gray-100">
    <div class="text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">404 - Страница не найдена</h1>
        <p class="text-gray-600 mb-8">Страница, которую вы ищете, не существует или была удалена</p>
        <a href="/" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors">
            На главную
        </a>
    </div>
</div>
}

templ Errors403Page() {
@layout.Layout(layout.LayoutProps{
Title: "Ошибка 403 - Доступ запрещен",
MetaDescription: "У вас недостаточно прав для просмотра этой страницы",
IsAuthenticated: false,
})
<div class="min-h-screen flex items-center justify-center bg-gray-100">
    <div class="text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">403 - Доступ запрещен</h1>
        <p class="text-gray-600 mb-8">У вас недостаточно прав для просмотра этой страницы</p>
        <a href="/" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors">
            На главную
        </a>
    </div>
</div>
}
