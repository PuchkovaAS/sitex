package views

import (
"fmt"
"sitex/internal/resources"
"sitex/views/components"
"sitex/views/layout"
"sitex/views/widgets"
)

type MaterailResourcesProps struct {
Email string
TotalPage int
CurrentPage int
TotalItems int
IsAdmin bool
Resources []resources.Resource
}

templ MaterailResources(props MaterailResourcesProps) {
@layout.Layout(layout.LayoutProps{
Title: "Материальные ресурсы",
MetaDescription: "Страница метериальных ресурсов",
IsAuthenticated: true,
}) {
<div class="my-2 p-2">
    <h3 class="mb-4 text-lg font-semibold text-gray-900">Материальные ресурсы</h3>
    <div class="flex space-x-2 mb-4 border-b border-gray-200"></div>
    @components.CounterItemsPage(components.CounterItemsProps{
    CurrentPage: props.CurrentPage,
    TotalItems: props.TotalItems,
    TotalPages: props.TotalPage,
    })
</div>
if props.IsAdmin {
<button type="button"
    class="inline-flex items-center gap-2 bg-blue-600 text-white text-sm font-medium py-2 px-4 rounded-lg  transition-colors"
    onclick="document.getElementById('add-resource-form-container').classList.toggle('hidden')">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
    </svg>
    Добавить новую запись
</button>
}
@widgets.AddResourceForm(props.Email)
<div class="flex flex-col  my-2 gap-1">
    for _, item := range props.Resources {
    @widgets.ResourceStatusWidget(widgets.ResourceStatusProps{
    ID: int(item.ID),
    Status: item.Status,
    ResourceName: item.ResourceName,
    Description: item.Description,
    UserName: item.Employee.LastName + " " + item.Employee.FirstName,
    Email: item.Employee.Email,
    Quantity: item.Quantity,
    WhoAddEvent: item.AddedBy.LastName + " " + item.AddedBy.FirstName,
    DateAdd: item.Date,
    IsAdmin: props.IsAdmin,
    })
    }
</div>
@components.PaginationNum(components.PaginationNumProps{
UrlPath: fmt.Sprintf("/resources?email=%s&", props.Email),
TotalPage: props.TotalPage,
CurrentPage: props.CurrentPage,
})
}
}
